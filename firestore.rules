rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFfxPreset(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120 &&
             data.category is string && data.category in ['Color Grade', 'Motion & Shake', 'Glow & Optics', 'Film & Retro', 'Transform', 'Custom .ffx'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
             data.sourceType is string && data.sourceType in ['studio', 'imported_ffx', 'custom'] &&
             (!('ffxVersion' in data) || (data.ffxVersion is string && data.ffxVersion.size() <= 40)) &&
             (!('effectModules' in data) || (data.effectModules is list && data.effectModules.size() <= 12 && (data.effectModules.size() == 0 || data.effectModules[0] is string))) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             data.isFavorite is bool &&
             data.exposure is number && data.exposure >= -1.0 && data.exposure <= 1.0 &&
             data.contrast is number && data.contrast >= -1.0 && data.contrast <= 1.0 &&
             data.saturation is number && data.saturation >= -100.0 && data.saturation <= 100.0 &&
             data.hueShift is number && data.hueShift >= -180.0 && data.hueShift <= 180.0 &&
             data.temperature is number && data.temperature >= -1.0 && data.temperature <= 1.0 &&
             data.tint is number && data.tint >= -1.0 && data.tint <= 1.0 &&
             data.vignetteIntensity is number && data.vignetteIntensity >= 0.0 && data.vignetteIntensity <= 1.0 &&
             data.glowIntensity is number && data.glowIntensity >= 0.0 && data.glowIntensity <= 1.0 &&
             data.grainAmount is number && data.grainAmount >= 0.0 && data.grainAmount <= 1.0 &&
             data.zoomPulse is number && data.zoomPulse >= 0.0 && data.zoomPulse <= 1.0 &&
             data.shakeIntensity is number && data.shakeIntensity >= 0.0 && data.shakeIntensity <= 1.0 &&
             data.rotationDegrees is number && data.rotationDegrees >= -180.0 && data.rotationDegrees <= 180.0 &&
             data.speedMultiplier is number && data.speedMultiplier >= 0.25 && data.speedMultiplier <= 4.0 &&
             data.letterboxRatio is number && data.letterboxRatio >= 0.0 && data.letterboxRatio <= 0.35 &&
             (!('rawHeaderSnippet' in data) || (data.rawHeaderSnippet is string && data.rawHeaderSnippet.size() <= 1000)) &&
             data.usageCount is int && data.usageCount >= 0;
    }

    function isValidExportRecord(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.presetId is string && data.presetId.size() >= 1 && data.presetId.size() <= 128 &&
             data.presetName is string && data.presetName.size() >= 1 && data.presetName.size() <= 80 &&
             data.outputFileName is string && data.outputFileName.size() >= 1 && data.outputFileName.size() <= 150 &&
             data.resolutionLabel is string && data.resolutionLabel.size() >= 1 && data.resolutionLabel.size() <= 40 &&
             data.codecLabel is string && data.codecLabel.size() >= 1 && data.codecLabel.size() <= 40 &&
             data.bitrateMbps is int && data.bitrateMbps >= 1 && data.bitrateMbps <= 200 &&
             data.fileSizeBytes is int && data.fileSizeBytes >= 0 &&
             data.durationMs is int && data.durationMs >= 0 &&
             data.localUriString is string && data.localUriString.size() <= 500;
    }

    match /users/{userId}/presets/{presetId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(presetId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(presetId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'fileName', 'category', 'sourceType', 'isFavorite',
                         'exposure', 'contrast', 'saturation', 'hueShift', 'temperature', 'tint',
                         'vignetteIntensity', 'glowIntensity', 'grainAmount', 'zoomPulse',
                         'shakeIntensity', 'rotationDegrees', 'speedMultiplier', 'letterboxRatio',
                         'usageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'fileName', 'category', 'description', 'sourceType',
                         'ffxVersion', 'effectModules', 'tags', 'isFavorite',
                         'exposure', 'contrast', 'saturation', 'hueShift', 'temperature', 'tint',
                         'vignetteIntensity', 'glowIntensity', 'grainAmount', 'zoomPulse',
                         'shakeIntensity', 'rotationDegrees', 'speedMultiplier', 'letterboxRatio',
                         'rawHeaderSnippet', 'usageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidFfxPreset(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(presetId) &&
                       isValidFfxPreset(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'fileName', 'category', 'description', 'ffxVersion',
                         'effectModules', 'tags', 'isFavorite',
                         'exposure', 'contrast', 'saturation', 'hueShift', 'temperature', 'tint',
                         'vignetteIntensity', 'glowIntensity', 'grainAmount', 'zoomPulse',
                         'shakeIntensity', 'rotationDegrees', 'speedMultiplier', 'letterboxRatio',
                         'rawHeaderSnippet', 'usageCount', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(presetId);
    }

    match /users/{userId}/exports/{exportId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(exportId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(exportId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'presetId', 'presetName', 'outputFileName', 'resolutionLabel',
                         'codecLabel', 'bitrateMbps', 'fileSizeBytes', 'durationMs',
                         'localUriString', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'presetId', 'presetName', 'outputFileName', 'resolutionLabel',
                         'codecLabel', 'bitrateMbps', 'fileSizeBytes', 'durationMs',
                         'localUriString', 'createdAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidExportRecord(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(exportId);
    }
  }
}
